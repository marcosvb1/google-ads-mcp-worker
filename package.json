{
  "name": "google-ads-mcp-worker",
  "version": "0.1.0",
  "description": "Remote MCP server for the Google Ads API, running on Cloudflare Workers. Implements MCP spec 2026-07-28 (stateless Streamable HTTP).",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Marcos Vinícius Borges",
  "homepage": "https://github.com/marcosvb1/google-ads-mcp-worker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcosvb1/google-ads-mcp-worker.git"
  },
  "bugs": {
    "url": "https://github.com/marcosvb1/google-ads-mcp-worker/issues"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "google-ads",
    "cloudflare-workers",
    "gaql",
    "ppc"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector@latest"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "jose": "^6.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.3",
    "@cloudflare/workers-types": "^5.20260804.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=20"
  }
}
